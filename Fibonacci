#include <iostream>
using namespace std;

int main() {
    int n, a = 0, b = 1;
    
    cout << "Ingrese la cantidad de terminos: ";
    cin >> n;
    
    for (int i = 0; i < n; i++) {
        cout << a << " ";
        int c = a + b; // Suma los dos anteriores
        a = b;         // Desplaza 'b' a 'a'
        b = c;         // Desplaza el nuevo valor 'c' a 'b'
    }
    
    cout << endl;
    return 0;
}
