#include <iostream>
using namespace std;

int main() {
    // Bucle externo: controla la tabla (del 1 al 5)
    for (int i = 1; i <= 5; i++) {
        
        // Bucle interno: controla el multiplicador (del 1 al 5)
        for (int j = 1; j <= 5; j++) {
            cout << i << " x " << j << " = " << (i * j) << endl;
        }
        
        cout << "------------------" << endl; // Separador entre tablas
    }
    
    return 0;
}
