#include <iostream>
using namespace std;

int main() {
    int n = 3;
    
    // Bucle externo para las filas
    for (int i = 1; i <= n; i++) {
        // Bucle interno para las columnas
        for (int j = 1; j <= i; j++) {
            cout << j << " ";
        }
        cout << endl; // Salto de línea al terminar cada fila
    }
    
    return 0;
}
