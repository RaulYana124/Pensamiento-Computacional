#include <iostream>
using namespace std;

int main() {
    int n = 5; // Tamaño de la matriz
    
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            // Si la suma de la fila y la columna es par, imprime asterisco; si no, espacio
            if ((i + j) % 2 == 0) {
                cout << "* ";
            } else {
                cout << "  "; // Espacio vacío
            }
        }
        cout << endl;
    }
    
    return 0;
}
